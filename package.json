{
  "name": "park-workdesk",
  "version": "0.1.0",
  "private": true,
  "description": "폐쇄망용 공원 업무 수첩",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "desktop": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "postinstall": "node node_modules/electron/install.js",
    "test:desktop": "npm run build && node tests/desktop-smoke.cjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1",
    "typescript": "5.9.2",
    "undici": "8.12.1",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "local.park.workdesk",
    "productName": "공원 업무 수첩",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
