{
  "name": "park-workdesk",
  "version": "0.5.0",
  "description": "국립공원 레인저·사무소 직원을 위한 로컬 업무 수첩 및 사무소 현황판",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "test": "node --test tests/store.test.cjs tests/office.test.cjs",
    "test:desktop": "npm run build && node tests/desktop-smoke.cjs"
  },
  "build": {
    "appId": "kr.park.workdesk.prototype",
    "productName": "공원 업무 수첩",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "shared/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName} ${version}.${ext}"
    }
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
